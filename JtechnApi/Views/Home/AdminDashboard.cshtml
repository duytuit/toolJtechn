@{
    ViewData["Title"] = "Trang quản trị";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <p class="section-kicker">Tổng quan</p>
        <h2 class="mb-0">Trang quản trị viên</h2>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#reportForm">+ Tạo báo cáo</button>
</div>

<div id="statsGrid" class="row g-4 mb-4" aria-live="polite"></div>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="panel-card h-100">
            <div class="panel-head">
                <h5>Biểu đồ sản lượng</h5>
                <span class="badge-soft">7 ngày gần nhất</span>
            </div>
            <div id="productionChart" class="chart-box" aria-label="Biểu đồ sản lượng"></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="panel-card h-100">
            <div class="panel-head">
                <h5>Nhập dữ liệu</h5>
            </div>
            <form id="reportForm" class="collapse show" novalidate>
                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                {
                    Id = "reportTitle",
                    Name = "title",
                    Label = "Tên báo cáo",
                    Placeholder = "Ví dụ: Báo cáo sản lượng",
                    Required = true
                })
                @await Html.PartialAsync("_ApiFilterDropdown", new JtechnApi.ViewModels.ApiFilterDropdownModel
                {
                    Id = "reportDepartment",
                    Name = "department",
                    Label = "Bộ phận",
                    Endpoint = "/api/demo/departments",
                    QueryParameter = "name",
                    ValueField = "id",
                    LabelField = "name",
                    DataPath = "items",
                    Required = true
                })
                <button class="btn btn-primary w-100" type="submit">Lưu dữ liệu</button>
                <div id="formMessage" class="small mt-3" role="status"></div>
            </form>
        </div>
    </div>
</div>

<div class="panel-card">
    <div class="panel-head flex-wrap gap-3">
        <div>
            <h5 class="mb-1">Danh sách đơn hàng</h5>
            <small class="text-muted">Dữ liệu được tải từ dashboard API</small>
        </div>
        @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
        {
            Id = "orderFilter",
            Name = "orderFilter",
            Label = "Tìm đơn hàng",
            Type = "search",
            Placeholder = "Lọc mã, bộ phận, trạng thái...",
            CssClass = "table-filter"
        })
        @await Html.PartialAsync("_DateTimeRange", new JtechnApi.ViewModels.DateTimeRangeModel
        {
            Id = "orderDateRange",
            Label = "Khoảng thời gian",
            StartName = "startDate",
            EndName = "endDate"
        })
    </div>
    @await Html.PartialAsync("_DataTable", new JtechnApi.ViewModels.DataTableModel
    {
        Id = "ordersDataTable",
        PageSize = 10,
        EnableSearch = false,
        EmptyMessage = "Không tìm thấy dữ liệu.",
        Columns = new[]
        {
            new JtechnApi.ViewModels.DataTableColumnModel { Field = "code", Header = "Mã đơn", Format = "strong" },
            new JtechnApi.ViewModels.DataTableColumnModel { Field = "department", Header = "Bộ phận" },
            new JtechnApi.ViewModels.DataTableColumnModel { Field = "status", Header = "Trạng thái", Format = "badge" },
            new JtechnApi.ViewModels.DataTableColumnModel { Field = "date", Header = "Ngày cập nhật" }
        }
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const statsGrid = document.querySelector('#statsGrid');
            const chart = document.querySelector('#productionChart');
            const filter = document.querySelector('#orderFilter');
            const dateRange = document.querySelector('#orderDateRange');
            const dateStart = dateRange.querySelector('[data-range-start]');
            const dateEnd = dateRange.querySelector('[data-range-end]');
            let orders = [];

            const renderStats = (stats) => {
                statsGrid.innerHTML = stats.map(stat => `
                    <div class="col-lg-3 col-md-6">
                        <div class="stat-card">
                            <span class="stat-label">${stat.label}</span>
                            <h3>${stat.value}</h3>
                            <small class="text-${stat.tone}">${stat.trend}</small>
                        </div>
                    </div>`).join('');
            };

            const renderChart = (values) => {
                chart.innerHTML = values.map((value, index) => `
                    <div class="chart-bar-wrap">
                        <span class="chart-value">${value}</span>
                        <span class="chart-bar" style="height: ${value}%"></span>
                        <small>Ngày ${index + 1}</small>
                    </div>`).join('');
            };

            const renderOrders = () => {
                const keyword = filter.value.trim().toLowerCase();
                const filtered = orders.filter(order =>
                    `${order.code} ${order.department} ${order.status} ${order.date}`.toLowerCase().includes(keyword)
                    && (!dateStart.value || parseOrderDate(order.date) >= new Date(dateStart.value))
                    && (!dateEnd.value || parseOrderDate(order.date) <= new Date(dateEnd.value)));

                window.JtechnDataTable.setRows('ordersDataTable', filtered);
            };

            const parseOrderDate = (value) => {
                const [day, month, year] = value.split('/').map(Number);
                return new Date(year, month - 1, day);
            };

            try {
                const response = await fetch('/api/admin/dashboard/data');
                if (!response.ok) throw new Error('Không tải được dữ liệu dashboard');
                const data = await response.json();
                orders = data.orders;
                renderStats(data.stats);
                renderChart(data.production);
                renderOrders();
            } catch (error) {
                statsGrid.innerHTML = `<div class="col-12"><div class="alert alert-danger">${error.message}</div></div>`;
            }

            filter.addEventListener('input', renderOrders);
            dateRange.addEventListener('change', renderOrders);
            document.querySelector('#reportForm').addEventListener('submit', function (event) {
                event.preventDefault();
                document.querySelector('#formMessage').className = 'small mt-3 text-success';
                document.querySelector('#formMessage').textContent = 'Đã lưu dữ liệu mẫu thành công.';
                event.target.reset();
            });
        });
    </script>
}
