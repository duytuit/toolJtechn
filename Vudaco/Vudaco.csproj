<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="dotAPNS" Version="4.6.0" />
    <PackageReference Include="EPPlus" Version="6.0.3" />
    <PackageReference Include="FirebaseAdmin" Version="3.4.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.76.0.4261" />

    <!-- ASP.NET Core 6 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.36" />

    <!-- EF Core 6 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.36" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.36" />

    <!-- Microsoft Extensions 6 -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="6.0.36" />

    <PackageReference Include="MySql.Data" Version="9.4.0" />

    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="5.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Vehicles\Dtos\" />

    <Folder Include="Customers\Controllers\" />
    <Folder Include="Customers\Dtos\" />
    <Folder Include="Customers\Models\" />
    <Folder Include="Customers\Repositories\" />

    <Folder Include="Requireds\Controllers\" />
    <Folder Include="Requireds\Dtos\" />
    <Folder Include="Requireds\Models\" />
    <Folder Include="Requireds\Repositories\" />

    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!-- Không publish thư mục uploads -->
  <ItemGroup>
    <Content Update="wwwroot\uploads\**\*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Tạo thư mục Logs khi Publish -->
  <Target Name="CreateLogsDirectory" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Logs" />
  </Target>

  <ItemGroup>
    <Content Update="web.config">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>