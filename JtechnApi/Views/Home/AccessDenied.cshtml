@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jtechn</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
</head>
<body>
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <section class="panel-card text-center p-5" role="alert">
            <p class="section-kicker">Truy cập bị từ chối</p>
            <h1 class="h3 mb-3">Bạn chưa được cấp quyền cho chức năng này.</h1>
            <p class="text-muted mb-4">Liên hệ quản trị viên nếu bạn cần được cấp quyền.</p>
            <a class="btn btn-primary" href="/admin">Quay lại trang quản trị</a>
            <a class="btn btn-outline-secondary ms-2" href="/logout">Đăng xuất</a>
        </section>
    </main>
</body>
</html>
