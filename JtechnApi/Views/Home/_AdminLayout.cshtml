@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jtechn</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="page-wrap">
        <aside class="sidebar">
            <div class="brand">
                <img class="sidebar-logo" src="~/img/logo.jpg" alt="Jtechn" />
                <div>
                    <strong>Jtechn</strong><br />
                    <small class="text-white-50">Admin Portal</small>
                </div>
            </div>
            <nav>
                <a class="active" href="#">Dashboard</a>
                <a href="#">Nhân sự</a>
                <a href="#">Sản xuất</a>
                <a href="#">Báo cáo</a>
                <a href="#">Cài đặt</a>
            </nav>
        </aside>
        <main class="content-area">
            @RenderBody()
        </main>
    </div>
</body>
</html>
