<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!-- <CheckEolTargetFramework>false</CheckEolTargetFramework> -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>

    <!-- AutoMapper -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="11.0.0" />

    <!-- Dapper -->
    <PackageReference Include="Dapper" Version="2.1.35" />

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Excel -->
    <PackageReference Include="EPPlus" Version="6.0.8" />

    <!-- SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.5" />

    <!-- HTTP -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="6.0.0" />

    <!-- Oracle -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="3.21.120" />

    <!-- EF Core 6 / MySQL -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="6.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.28" />

    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="6.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

    <!-- Image -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />

    <!-- Redis -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />

    <!-- Dynamic LINQ -->
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.6" />

    <!-- OCR -->
    <PackageReference Include="Tesseract" Version="5.2.0" />

  </ItemGroup>

  <ItemGroup>
    <Content Update="web.config">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>