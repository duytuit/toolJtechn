@{
    ViewData["Title"] = "Aether AI | Create beyond limits";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080b12" />
    <meta name="description" content="Aether is an intelligent creative workspace for turning ambitious ideas into extraordinary work." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
</head>
<body>
    <main>
        <section class="ai-hero" id="top" aria-labelledby="heroTitle">
            <div class="hero-background" aria-hidden="true">
                <div class="hero-grid"></div>
                <div class="hero-vignette"></div>
                <div class="hero-glow hero-glow--blue" data-parallax="-0.35"></div>
                <div class="hero-glow hero-glow--violet" data-parallax="0.22"></div>
                <div class="hero-glow hero-glow--cyan" data-parallax="-0.18"></div>
                <div class="hero-noise"></div>
            </div>

            <header class="hero-header">
                <a class="brand" href="#top" aria-label="Aether home">
                    <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2.5 29.5 26H2.5L16 2.5Z" /><path d="M16 11.5 22.2 22H9.8L16 11.5Z" /></svg>
                    <span>AETHER<span class="brand-period">.</span></span>
                </a>

                <nav class="desktop-nav" aria-label="Main navigation">
                    <a href="#platform">Menu</a>
                    <a href="#get-started">Contact</a>
                </nav>

                <div class="header-actions">
                    <a class="login-link" href="/Home/Login">Log in</a>
                </div>

                <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNav">
                    <span></span><span></span>
                </button>
            </header>

            <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation" inert>
                <a href="#platform">Menu</a>
                <a href="#get-started">Contact</a>
                <a href="/Home/Login">Log in</a>
            </nav>

            <div class="hero-copy" data-parallax="0.08">
                <p class="hero-badge"><span class="status-dot"></span><span>INTELLIGENCE, IN A NEW LIGHT</span><span class="badge-index">NO. 01</span></p>
                <h1 class="hero-title" id="heroTitle" aria-label="Build the future with AI">
                    <span class="title-line"><span class="title-word">BUILD</span><span class="title-word title-word--the">THE</span></span>
                    <span class="title-line"><span class="title-word title-word--gradient">FUTURE</span><span class="title-word title-word--with">WITH</span></span>
                    <span class="title-line title-line--last"><span class="title-word">AI</span><span class="title-line-note">A CREATIVE<br />INTELLIGENCE</span></span>
                </h1>
                <p class="hero-description">Powerful AI tools for modern digital creators.<br class="desktop-break" /> Imagine further. Make it real.</p>
                <div class="hero-actions">
                    <a class="button button-primary magnetic-button" href="#get-started" aria-label="Get started with Aether">
                        <span>Get started</span><span class="button-arrow" aria-hidden="true">↗</span>
                    </a>
                    <a class="button button-secondary magnetic-button" href="#platform" aria-label="Explore the Aether platform">
                        <span class="play-icon" aria-hidden="true">▶</span><span>Explore</span>
                    </a>
                </div>
            </div>

            <div class="hero-stage" role="img" aria-label="Abstract animated AI neural core">
                <div class="stage-orbit stage-orbit--outer"></div>
                <div class="stage-orbit stage-orbit--middle"></div>
                <div class="stage-orbit stage-orbit--inner"></div>
                <div class="stage-core-wrap">
                    <div class="stage-core" data-parallax="0.22">
                        <div class="core-shine"></div>
                        <svg class="core-network" viewBox="0 0 500 500" role="presentation" aria-hidden="true">
                            <defs>
                                <radialGradient id="coreFill" cx="35%" cy="28%" r="75%"><stop offset="0" stop-color="#f2ffff" stop-opacity=".95" /><stop offset=".2" stop-color="#93e9e7" stop-opacity=".72" /><stop offset=".58" stop-color="#5575e8" stop-opacity=".25" /><stop offset="1" stop-color="#11172b" stop-opacity=".04" /></radialGradient>
                                <linearGradient id="coreLine" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e8ffff" stop-opacity=".9" /><stop offset=".48" stop-color="#7ce5e3" stop-opacity=".72" /><stop offset="1" stop-color="#918bff" stop-opacity=".42" /></linearGradient>
                                <clipPath id="coreClip"><circle cx="250" cy="250" r="181" /></clipPath>
                            </defs>
                            <circle cx="250" cy="250" r="181" fill="url(#coreFill)" />
                            <g clip-path="url(#coreClip)" fill="none" stroke="url(#coreLine)" stroke-width="1.25">
                                <ellipse cx="250" cy="250" rx="170" ry="58" transform="rotate(-34 250 250)" />
                                <ellipse cx="250" cy="250" rx="170" ry="58" transform="rotate(34 250 250)" />
                                <ellipse cx="250" cy="250" rx="156" ry="84" transform="rotate(90 250 250)" />
                                <path d="M70 234c52-58 114-83 180-75 66 8 126 42 181 102M70 276c55 60 115 94 181 102 66 8 128-17 180-75M105 129c58 42 108 82 145 121 37 39 87 79 145 121M107 371c57-43 105-83 143-121 38-38 88-78 143-121" />
                            </g>
                            <circle cx="250" cy="250" r="181" fill="none" stroke="#d8ffff" stroke-opacity=".36" />
                            <circle cx="250" cy="250" r="5" fill="#f4ffff" />
                        </svg>
                        <span class="core-glint core-glint--one"></span>
                        <span class="core-glint core-glint--two"></span>
                    </div>
                </div>

                <div class="orbit-point orbit-point--one" aria-hidden="true"><span></span></div>
                <div class="orbit-point orbit-point--two" aria-hidden="true"><span></span></div>
                <div class="orbit-point orbit-point--three" aria-hidden="true"><span></span></div>

                <div class="float-card float-card--prompt" data-float="1" data-parallax="0.42" aria-hidden="true">
                    <span class="card-kicker"><span class="card-spark">✳</span> PROMPT / 014</span>
                    <span class="card-prompt">A world<br />without edges</span>
                    <span class="card-progress"><i></i></span>
                </div>
                <div class="float-card float-card--signal" data-float="2" data-parallax="-0.32" aria-hidden="true">
                    <span class="signal-label">NEURAL SIGNAL</span>
                    <span class="signal-value">98<span>%</span></span>
                    <span class="signal-wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
                </div>
                <div class="float-chip" data-float="3" data-parallax="0.55" aria-hidden="true"><span class="chip-pulse"></span> MODEL ACTIVE</div>
            </div>

            <a class="scroll-indicator" href="#platform" aria-label="Scroll to explore the platform">
                <span class="scroll-label">SCROLL TO EXPLORE</span>
                <span class="scroll-track"><span></span></span>
            </a>
            <div class="hero-coordinates" aria-hidden="true"><span>CREATIVE SYSTEMS</span><span>37° 46' 30.0" N</span></div>
        </section>

        <section class="next-section" id="platform" aria-labelledby="platformTitle">
            <div class="next-section-inner">
                <p class="section-eyebrow"><span></span> A DIFFERENT KIND OF TOOLKIT</p>
                <h2 id="platformTitle">Your ideas,<br /><span>without the ceiling.</span></h2>
                <p id="studio">One intelligent workspace to imagine, refine, and bring your next big thing to life.</p>
                <a id="get-started" class="next-link" href="mailto:hello@aether.ai">Meet your creative edge <span aria-hidden="true">↗</span></a>
            </div>
            <div class="next-glow" aria-hidden="true"></div>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="~/js/hero.js" asp-append-version="true" defer></script>
</body>
</html>