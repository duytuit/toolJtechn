@{
    ViewData["Title"] = ViewData["EmployeeId"] == null ? "Thêm nhân viên" : "Cập nhật nhân viên";
    Layout = "_Layout";
}

<div class="page-header panel-card">
    <div>
        <p class="section-kicker">Nhân sự</p>
        <h2 class="mb-0" id="employeePageTitle">@ViewData["Title"]</h2>
    </div>
    <a class="btn btn-outline-secondary" href="/admin/employees">Quay lại danh sách</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <section id="employeeFormPanel" class="panel-card" data-employee-id="@(ViewData["EmployeeId"] ?? "")">
            <div class="panel-head">
                <div>
                    <p class="section-kicker mb-1">Thông tin nhân sự</p>
                    <h5 class="mb-0" data-form-title>@ViewData["Title"]</h5>
                </div>
            </div>

            <div id="employeeLoadMessage" class="small mb-3" role="status" aria-live="polite"></div>

            <form id="employeeForm">
                <fieldset id="employeeFields">
                    <div class="border-top pt-3 mt-2">
                        <p class="section-kicker mb-3">Thông tin cơ bản</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "employeeCode",
                                    Name = "employeeCode",
                                    Label = "Mã nhân viên",
                                    Placeholder = "Nhập mã nhân viên",
                                    Autocomplete = "off",
                                    MaxLength = 100,
                                    Required = true
                                })
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "fullName",
                                    Name = "fullName",
                                    Label = "Họ và tên",
                                    Placeholder = "Nhập họ và tên",
                                    Autocomplete = "name",
                                    MaxLength = 200,
                                    Required = true
                                })
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-3 mt-4">
                        <p class="section-kicker mb-3">Liên hệ và công việc</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "phone",
                                    Name = "phone",
                                    Label = "Số điện thoại",
                                    Type = "tel",
                                    Placeholder = "Nhập số điện thoại",
                                    Autocomplete = "tel",
                                    MaxLength = 50
                                })
                            </div>
                            <div class="col-md-4">
                                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "department",
                                    Name = "department",
                                    Label = "Bộ phận",
                                    Placeholder = "Nhập bộ phận",
                                    MaxLength = 200
                                })
                            </div>
                            <div class="col-md-4">
                                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "position",
                                    Name = "position",
                                    Label = "Chức vụ",
                                    Placeholder = "Nhập chức vụ",
                                    MaxLength = 200
                                })
                            </div>
                            <div class="col-md-4">
                                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "gender",
                                    Name = "gender",
                                    Label = "Giới tính",
                                    Placeholder = "Nhập giới tính",
                                    MaxLength = 50
                                })
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-3 mt-4">
                        <p class="section-kicker mb-3">Thời gian làm việc</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_DatePicker", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "dateOfBirth",
                                    Name = "dateOfBirth",
                                    Label = "Ngày sinh"
                                })
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_DatePicker", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "joinDate",
                                    Name = "joinDate",
                                    Label = "Ngày vào làm"
                                })
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_DatePicker", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "probationEndDate",
                                    Name = "probationEndDate",
                                    Label = "Kết thúc thử việc"
                                })
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_DatePicker", new JtechnApi.ViewModels.CompactInputModel
                                {
                                    Id = "leaveDate",
                                    Name = "leaveDate",
                                    Label = "Ngày nghỉ việc"
                                })
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" id="isActive" name="isActive" type="checkbox" checked />
                                    <label class="form-check-label" for="isActive">Đang làm việc</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <div class="border-top pt-3 mt-4">
                    <div id="employeeMessage" class="small mb-3" role="status" aria-live="polite"></div>
                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" href="/admin/employees">Hủy</a>
                        <button class="btn btn-primary" type="submit">Lưu nhân viên</button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const apiUrl = '/api/employees';
            const panel = document.querySelector('#employeeFormPanel');
            const form = document.querySelector('#employeeForm');
            const fields = document.querySelector('#employeeFields');
            const id = panel.dataset.employeeId;
            const message = document.querySelector('#employeeMessage');
            const loadMessage = document.querySelector('#employeeLoadMessage');
            const submit = form.querySelector('[type="submit"]');

            const getErrorMessage = async response => {
                try {
                    const body = await response.json();
                    if (body.message) return body.message;
                    if (body.detail) return body.detail;
                    if (body.errors) return Object.values(body.errors).flat().join(' ');
                } catch {
                    return `Yêu cầu thất bại (HTTP ${response.status}).`;
                }
                return `Yêu cầu thất bại (HTTP ${response.status}).`;
            };

            const setMessage = (element, text, isError) => {
                element.textContent = text;
                element.className = `small mb-3 ${isError ? 'text-danger' : 'text-success'}`;
            };

            const dateValue = value => value ? String(value).slice(0, 10) : '';

            const loadEmployee = async () => {
                const response = await fetch(`${apiUrl}/${id}`, { headers: { Accept: 'application/json' } });
                if (!response.ok) throw new Error(await getErrorMessage(response));
                const employee = await response.json();

                [
                    'employeeCode', 'fullName', 'phone',
                    'department', 'position', 'gender'
                ].forEach(name => {
                    const field = form.elements.namedItem(name);
                    field.value = employee[name] || '';
                    field.dispatchEvent(new Event('input', { bubbles: true }));
                });
                ['dateOfBirth', 'joinDate', 'probationEndDate', 'leaveDate'].forEach(name => {
                    const field = form.elements.namedItem(name);
                    field.value = dateValue(employee[name]);
                    field.dispatchEvent(new Event('input', { bubbles: true }));
                });
                form.elements.namedItem('isActive').checked = employee.isActive;
                document.querySelector('[data-form-title]').textContent = 'Cập nhật nhân viên';
                document.querySelector('#employeePageTitle').textContent = 'Cập nhật nhân viên';
            };

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!form.reportValidity()) return;

                const payload = Object.fromEntries(new FormData(form).entries());
                payload.isActive = form.elements.namedItem('isActive').checked;
                ['dateOfBirth', 'joinDate', 'probationEndDate', 'leaveDate'].forEach(name => {
                    payload[name] = payload[name] || null;
                });

                submit.disabled = true;
                try {
                    const response = await fetch(id ? `${apiUrl}/${id}` : apiUrl, {
                        method: id ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (!response.ok) throw new Error(await getErrorMessage(response));
                    const savedState = id ? 'updated' : 'created';
                    window.location.assign(`/admin/employees?saved=${savedState}`);
                } catch (error) {
                    setMessage(message, error.message, true);
                    window.JtechnUI.toast(error.message, 'error');
                    submit.disabled = false;
                }
            });

            if (id) {
                fields.disabled = true;
                submit.disabled = true;
                loadEmployee().then(() => {
                    fields.disabled = false;
                    submit.disabled = false;
                }).catch(error => {
                    setMessage(loadMessage, error.message, true);
                    window.JtechnUI.toast(error.message, 'error');
                });
            }
        });
    </script>
}
