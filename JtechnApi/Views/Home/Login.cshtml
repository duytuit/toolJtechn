@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jtechn</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-left">
                <div class="brand-box">
                    <span class="brand-mark">J</span>
                    <div>
                        <div class="small-label">HỆ THỐNG</div>
                        <h2>Jtechn Admin</h2>
                    </div>
                </div>

                <h1>Chào mừng trở lại</h1>
                <p>Quản lý nhân sự, sản xuất và dữ liệu vận hành trong một nền tảng duy nhất.</p>

                <ul class="feature-list">
                    <li>Dashboard real-time</li>
                    <li>Theo dõi quy trình sản xuất</li>
                    <li>Quản lý nhân viên & phân bộ phận</li>
                </ul>
            </div>

            <div class="auth-right">
                <div class="auth-form-wrap">
                    <div class="text-center mb-4">
                        <span class="badge-soft">ADMIN</span>
                        <h3 class="mt-2 mb-0">Đăng nhập</h3>
                    </div>

                    @if (TempData["LoginError"] is string loginError)
                    {
                        <div class="alert alert-danger">@loginError</div>
                    }

                    <form action="/login" method="post" novalidate>
                        <div class="mb-3">
                            <label class="form-label" for="username">Tên đăng nhập</label>
                            <input id="username" type="text" name="username" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="username" aria-describedby="username-validation" data-inline-validation required />
                            <span id="username-validation" class="field-validation-error" data-validation-message aria-live="polite"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">Đăng nhập</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/form-components.js" asp-append-version="true"></script>
</body>
</html>
