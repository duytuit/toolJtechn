@model JtechnApi.ViewModels.CompactInputModel
@{
    var validationId = $"{Model.Id}-validation";
}
<div class="compact-field compact-floating-field" data-floating-field>
    <input id="@Model.Id"
           name="@Model.Name"
           type="@Model.Type"
           value="@Model.Value"
           placeholder="@(string.IsNullOrWhiteSpace(Model.Placeholder) ? " " : Model.Placeholder)"
           autocomplete="@Model.Autocomplete"
           maxlength="@Model.MaxLength"
           class="form-control @Model.CssClass"
           aria-describedby="@validationId"
           data-inline-validation
           data-floating-input
           required="@Model.Required" />
    <label class="form-label" for="@Model.Id">@Model.Label</label>
    <span id="@validationId" class="field-validation-error" data-validation-message aria-live="polite"></span>
</div>
