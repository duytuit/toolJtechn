@{
    ViewData["Title"] = "Quản lý nhân viên";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <p class="section-kicker">Nhân sự</p>
        <h2 class="mb-0">Quản lý nhân viên</h2>
    </div>
    <button class="btn btn-primary" type="button" id="newEmployeeButton">+ Thêm nhân viên</button>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="panel-card">
            <div class="panel-head flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">Danh sách nhân viên</h5>
                    <small id="employeeCount" class="text-muted">Đang tải dữ liệu...</small>
                </div>
                @await Html.PartialAsync("_CompactInput", new JtechnApi.ViewModels.CompactInputModel
                {
                    Id = "employeeSearch",
                    Name = "employeeSearch",
                    Label = "Tìm nhân viên",
                    Type = "search",
                    Placeholder = "Tìm mã, tên, email...",
                    CssClass = "table-filter"
                })
                @await Html.PartialAsync("_FilterDropdown", new JtechnApi.ViewModels.FilterDropdownModel
                {
                    Id = "employeeDepartmentFilter",
                    Name = "department",
                    Label = "Lọc bộ phận",
                    Placeholder = "Tất cả bộ phận",
                    Options = new[]
                    {
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Sản xuất", Text = "Sản xuất" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Lắp ráp", Text = "Lắp ráp" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Kho vật tư", Text = "Kho vật tư" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Kiểm tra chất lượng", Text = "Kiểm tra chất lượng" }
                    }
                })
                @await Html.PartialAsync("_DateTimeRange", new JtechnApi.ViewModels.DateTimeRangeModel
                {
                    Id = "employeeCreatedAtRange",
                    Label = "Lọc theo ngày ghi nhận",
                    InputType = "date",
                    StartLabel = "Từ ngày",
                    EndLabel = "Đến ngày",
                    StartName = "createdAtStart",
                    EndName = "createdAtEnd"
                })
            </div>
            @await Html.PartialAsync("_DataTable", new JtechnApi.ViewModels.DataTableModel
            {
                Id = "employeeDataTable",
                PageSize = 10,
                EnableSearch = false,
                EnableEdit = true,
                EnableDelete = true,
                EmptyMessage = "Không có nhân viên phù hợp.",
                Columns = new[]
                {
                    new JtechnApi.ViewModels.DataTableColumnModel { Field = "code", Header = "Mã", Format = "strong" },
                    new JtechnApi.ViewModels.DataTableColumnModel { Field = "name", SecondaryField = "email", Header = "Nhân viên" },
                    new JtechnApi.ViewModels.DataTableColumnModel { Field = "department", Header = "Bộ phận" },
                    new JtechnApi.ViewModels.DataTableColumnModel { Field = "status", Header = "Trạng thái", Format = "badge" },
                    new JtechnApi.ViewModels.DataTableColumnModel { Field = "createdAt", Header = "Ngày ghi nhận", Format = "date" }
                }
            })
        </div>
    </div>

    <div class="col-xl-4">
        @await Html.PartialAsync("_EntityForm", new JtechnApi.ViewModels.EntityFormModel
        {
            Id = "employeeForm",
            PanelId = "employeeFormPanel",
            Title = "Thêm nhân viên",
            Endpoint = "/api/demo/employees",
            InsertTitle = "Thêm nhân viên",
            UpdateTitle = "Sửa nhân viên",
            InsertButtonText = "Lưu nhân viên",
            UpdateButtonText = "Cập nhật nhân viên",
            CancelButtonText = "Hủy",
            MessageId = "employeeMessage",
            ShowCancelButton = true,
            Fields = new[]
            {
                new JtechnApi.ViewModels.EntityFormFieldModel { Id = "employeeCode", Name = "code", Label = "Mã nhân viên", Placeholder = "NV-004", Required = true },
                new JtechnApi.ViewModels.EntityFormFieldModel { Id = "employeeName", Name = "name", Label = "Họ và tên", Placeholder = "Nguyễn Văn A", Required = true },
                new JtechnApi.ViewModels.EntityFormFieldModel { Id = "employeeEmail", Name = "email", Label = "Email", Type = "email", Placeholder = "a@jtechn.vn", Required = true },
                new JtechnApi.ViewModels.EntityFormFieldModel { Id = "employeeCreatedAt", Name = "createdAt", Label = "Ngày ghi nhận", Type = "date", Value = DateTime.Today.ToString("yyyy-MM-dd") },
                new JtechnApi.ViewModels.EntityFormFieldModel
                {
                    Id = "employeeDepartment",
                    Name = "department",
                    Label = "Bộ phận",
                    Type = "select",
                    Options = new[]
                    {
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Sản xuất", Text = "Sản xuất" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Lắp ráp", Text = "Lắp ráp" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Kho vật tư", Text = "Kho vật tư" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Kiểm tra chất lượng", Text = "Kiểm tra chất lượng" }
                    }
                },
                new JtechnApi.ViewModels.EntityFormFieldModel
                {
                    Id = "employeeStatus",
                    Name = "status",
                    Label = "Trạng thái",
                    Type = "select",
                    Options = new[]
                    {
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Đang làm việc", Text = "Đang làm việc" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Tạm nghỉ", Text = "Tạm nghỉ" },
                        new JtechnApi.ViewModels.CompactSelectOption { Value = "Nghỉ việc", Text = "Nghỉ việc" }
                    }
                }
            }
        })
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const apiUrl = '/api/demo/employees';
            const table = document.querySelector('#employeeDataTable');
            const search = document.querySelector('#employeeSearch');
            const departmentFilter = document.querySelector('#employeeDepartmentFilter');
            const dateRange = document.querySelector('#employeeCreatedAtRange');
            const dateStart = dateRange.querySelector('[data-range-start]');
            const dateEnd = dateRange.querySelector('[data-range-end]');
            const form = document.querySelector('#employeeForm');
            const message = document.querySelector('#employeeMessage');
            const count = document.querySelector('#employeeCount');
            let employees = [];

            const showMessage = (text, isError) => {
                message.className = `small mt-3 ${isError ? 'text-danger' : 'text-success'}`;
                message.textContent = text;
            };

            const render = () => {
                const keyword = search.value.trim().toLowerCase();
                const toDateValue = value => {
                    if (!value) return '';
                    return String(value).slice(0, 10);
                };
                const visible = employees.filter(employee =>
                    `${employee.code} ${employee.name} ${employee.email} ${employee.department}`.toLowerCase().includes(keyword)
                    && (!departmentFilter.value || employee.department === departmentFilter.value)
                    && (!dateStart.value || (employee.createdAt && toDateValue(employee.createdAt) >= dateStart.value))
                    && (!dateEnd.value || (employee.createdAt && toDateValue(employee.createdAt) <= dateEnd.value)));

                count.textContent = `${visible.length} nhân viên`;
                window.JtechnDataTable.setRows('employeeDataTable', visible);
            };

            const loadEmployees = async () => {
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error('Không tải được danh sách nhân viên.');
                employees = await response.json();
                if (!Array.isArray(employees)) throw new Error('API nhân viên không trả về danh sách hợp lệ.');
                render();
            };

            const resetForm = () => {
                window.JtechnEntityForm.reset(form);
                message.textContent = '';
            };

            const editEmployee = (employee) => {
                window.JtechnEntityForm.setValues(form, employee);
                document.querySelector('#employeeFormPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
            };

            form.addEventListener('entity-form:saved', async function (event) {
                try {
                    await loadEmployees();
                    showMessage(event.detail.method === 'PUT' ? 'Đã cập nhật nhân viên.' : 'Đã thêm nhân viên.', false);
                } catch (error) {
                    showMessage(error.message, true);
                }
            });

            form.addEventListener('entity-form:cancel', resetForm);
            table.addEventListener('datatable:edit', event => editEmployee(event.detail.row));
            table.addEventListener('datatable:delete', async function (event) {
                if (!confirm('Bạn có chắc muốn xóa nhân viên này?')) return;
                try {
                    const response = await fetch(`${apiUrl}/${event.detail.row.id}`, { method: 'DELETE' });
                    if (!response.ok) throw new Error('Không thể xóa nhân viên.');
                    await loadEmployees();
                    showMessage('Đã xóa nhân viên.', false);
                } catch (error) {
                    showMessage(error.message, true);
                }
            });

            search.addEventListener('input', render);
            departmentFilter.addEventListener('change', render);
            dateRange.addEventListener('change', render);
            document.querySelector('#newEmployeeButton').addEventListener('click', resetForm);
            loadEmployees().catch(error => {
                window.JtechnDataTable.showMessage('employeeDataTable', error.message || 'Không thể tải danh sách nhân viên.', true);
                showMessage(error.message || 'Không thể tải danh sách nhân viên.', true);
            });
        });
    </script>
}
