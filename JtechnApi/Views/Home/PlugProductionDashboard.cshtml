@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        try {
            if (localStorage.getItem('stamping-wire-theme-v2') === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch { }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/stamping-wire-production.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/plug-production.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <header class="topbar">
            <div class="brand">
                <div class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 21V8l4 2V6l4 2V3h8v18H4Z" /><path d="M8 14h2m3 0h2m3 0h1M8 18h2m3 0h2m3 0h1M14 6h2" />
                    </svg>
                </div>
                <div>
                    <div class="eyebrow">挿入工程の生産管理 / THEO DÕI SẢN XUẤT CÔNG ĐOẠN CẮM</div>
                    <h1>挿入工程の実績管理表 / BẢNG THÀNH TÍCH CÔNG ĐOẠN CẮM</h1>
                </div>
            </div>
            <div class="toolbar">
                <nav class="area-tabs" aria-label="生産工程 / Công đoạn sản xuất">
                    <a class="area-tab active" href="/plug-production" aria-current="page">挿入 / Cắm</a>
                </nav>
                <button class="icon-btn theme-button" id="themeButton" type="button" aria-label="ダークモードに切り替え / Chuyển sang giao diện tối">◐ Dark</button>
                <div class="clock" id="clock">--:--:--</div>
                <div class="live"><span class="live-dot"></span><span id="liveText">接続中 / Đang kết nối</span></div>
                <button class="icon-btn" id="refreshButton" type="button" title="今すぐ更新 / Cập nhật ngay" aria-label="今すぐ更新 / Cập nhật ngay">↻</button>
                <button class="icon-btn" id="fullscreenButton" type="button" title="全画面表示 / Toàn màn hình" aria-label="全画面表示 / Toàn màn hình">⛶</button>
            </div>
        </header>
        <section class="overview" aria-label="生産概要 / Tổng quan sản xuất">
            <article class="daily-goal" aria-label="1日の総目標 / Mục tiêu tổng cả ngày" aria-live="polite">
                <table><thead><tr><th scope="col">総目標 / Tổng mục tiêu<br /><span id="dailyTargetDate">—</span></th><th scope="col">実績 / Đạt được</th></tr></thead><tbody><tr><td rowspan="2" id="dailyTarget">—</td><td id="dailyActual">—</td></tr><tr><td id="dailyRate">—</td></tr></tbody></table>
            </article>
            <article class="metric target"><div class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="13" r="8"/><circle cx="11" cy="13" r="4"/><path d="m11 13 9-10m-5 0h5v5"/></svg></div><div><div class="metric-label">総目標 / Tổng mục tiêu</div><strong id="kpiTarget">—</strong><p id="targetTimeFrame">時点: — / Khung giờ: —</p></div></article>
            <article class="metric actual"><div class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20v-6h3v6m4 0V8h3v12m4 0V3h3v17"/></svg></div><div><div class="metric-label">実績 / Tổng thực tế</div><strong id="kpiActual">—</strong><p>実績生産数量 / Sản lượng đã ghi nhận</p></div></article>
            <article class="metric rate"><div class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10v6a5 5 0 0 1-10 0V3Zm0 2H3v3a4 4 0 0 0 4 4m10-7h4v3a4 4 0 0 1-4 4M12 14v6m-4 1h8"/></svg></div><div><div class="metric-label">完成率 / Tỷ lệ hoàn thành</div><strong id="kpiRate">—</strong><div class="overview-progress" role="progressbar" aria-label="完成率 / Tỷ lệ hoàn thành" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="totalProgress"></span></div></div></article>
            <article class="metric missing"><div class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 7 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5M3 17l9 5 9-5"/></svg></div><div><div class="metric-label">未達成</div><div class="metric-label">Sản lượng còn thiếu</div><strong id="kpiMissing">—</strong><p>完了必要数 / Số lượng cần hoàn thành</p></div></article>
        </section>
        <main class="production-layout">
            <section class="chart-panel" aria-label="挿入工程のグループ別生産量 / Biểu đồ sản lượng các nhóm Cắm">
                <div class="chart-header"><div class="chart-legend"><span><i class="target-key"></i>目標 / Mục tiêu</span><span><i class="actual-key"></i>実績 / Thực tế</span></div></div>
                <div class="chart-scroll" id="machineGrid" aria-live="polite"><div class="empty-state">生産データを読み込み中… / Đang tải dữ liệu sản xuất…</div></div>
            </section>
            <aside class="summary-panel" aria-labelledby="summaryTitle">
                <h2 id="summaryTitle"><span aria-hidden="true">▥</span> 月間品質実績<br /><span class="summary-subtitle">CHẤT LƯỢNG THÁNG <span id="summaryMonth"></span></span></h2>
                <table class="summary-table"><thead><tr><th>グループ / Nhóm</th><th>目標 / Mục tiêu lỗi</th><th>実績 / Lỗi phát sinh</th><th>評価 / Đánh giá</th></tr></thead><tbody><tr><td>—</td><td class="summary-target">—</td><td class="summary-actual">—</td><td><span class="summary-status">データなし / Chưa có dữ liệu</span></td></tr></tbody><tfoot></tfoot></table>
            </aside>
        </main>
        <footer class="footer"><span id="dataNote">データソース / Nguồn dữ liệu: Control_ProgramPlug_Visualize</span><span id="lastUpdated">未更新 / Chưa cập nhật</span></footer>
    </div>
    <script>
        (() => {
            const checkpoints = ['10:00', '12:00', '15:00', '17:00', '20:00'];
            const state = { rows: [], columns: [], totalRows: 0, truncated: false, qualityRows: [] };
            const $ = (selector) => document.querySelector(selector);
            const aliases = {
                group: ['GroupMember'],
                code: ['CodeSub'],
                name: ['NameSub'],
                dateProduction: ['DateProduction'],
                minute: ['MinuteProduction'],
                title: ['GroupMember', 'MachineName', 'Machine', 'MachineNo', 'MachineNumber', 'MachineCode', 'ProductName', 'Product', 'CodeProduct', 'NameLD', 'CodeLD', 'NumberLot', 'ProgramNo', 'OrderNo', 'TenMay', 'MaMay'],
                actual: ['QtyActual', 'ActualQty', 'Actual', 'TotalActual', 'QtyOutput', 'OutputQty', 'ActualQuantity', 'ProductionQuantity', 'ProducedQty', 'SoLuongThucTe'],
                target: ['QtyTarget', 'TargetQty', 'Target', 'TotalTarget', 'QtyPlan', 'PlanQty', 'QtyRequest', 'TargetQuantity', 'SoLuongMucTieu', 'KeHoach']
            };
            const normalize = (value) => String(value ?? '')
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .toLowerCase().replace(/[^a-z0-9]/g, '');
            const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[char]));
            const formatNumber = (value, digits = 0) => value != null && Number.isFinite(Number(value))
                ? Number(value).toLocaleString('vi-VN', { maximumFractionDigits: digits }).replace(/\./g, ',')
                : '—';
            const findColumn = (names) => {
                const normalized = names.map(normalize);
                return state.columns.find((column) => normalized.includes(normalize(column)))
                    ?? state.columns.find((column) => normalized.some((name) => normalize(column).includes(name)));
            };
            const valueOf = (row, names) => {
                const column = findColumn(names);
                return column ? row[column] : null;
            };
            const numberOf = (value) => {
                if (value == null || value === '') return null;
                const numeric = Number(String(value).replace(/,/g, '').trim());
                return Number.isFinite(numeric) ? numeric : null;
            };
            const statusOf = (actual, target) => {
                if (target == null || actual == null) return 'running';
                return actual >= target ? 'achieved' : 'delayed';
            };
            const statusText = (status) => ({
                running: '稼働中 / Đang sản xuất', achieved: '目標達成 / Đạt mục tiêu',
                delayed: '遅延 / Chậm tiến độ', paused: '一時停止 / Tạm dừng'
            }[status]);
            const productionMinuteOf = (row) => {
                const value = valueOf(row, aliases.minute);
                const match = String(value ?? '').match(/(?:^|[T\s])(\d{1,2}):(\d{2})/);
                if (!match) return null;
                return Number(match[1]) * 60 + Number(match[2]);
            };
            const currentCheckpoint = () => {
                const now = new Date();
                const time = now.getHours() * 60 + now.getMinutes();
                return checkpoints.reduce((current, label, index) => {
                    const [hour, minute] = label.split(':').map(Number);
                    return time >= hour * 60 + minute ? index : current;
                }, -1);
            };
            const nextCheckpoint = () => {
                const now = new Date();
                const time = now.getHours() * 60 + now.getMinutes();
                const next = checkpoints.findIndex((label) => {
                    const [hour, minute] = label.split(':').map(Number);
                    return time < hour * 60 + minute;
                });
                return next < 0 ? checkpoints.length - 1 : next;
            };
            const todayString = () => {
                const now = new Date();
                return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
            };
            const records = () => {
                const now = new Date();
                const groups = new Map();
                state.rows.forEach((row) => {
                    const group = String(valueOf(row, aliases.group) ?? '').trim();
                    const code = String(valueOf(row, aliases.code) ?? '').trim();
                    const name = String(valueOf(row, aliases.name) ?? '').trim();
                    const key = [group, code, name].join('|');
                    if (!groups.has(key)) groups.set(key, { group, code, name, rows: [] });
                    groups.get(key).rows.push(row);
                });
                return Array.from(groups.values(), (item) => {
                    item.rows.sort((a, b) => (productionMinuteOf(a) ?? -1) - (productionMinuteOf(b) ?? -1));
                    const productionDate = String(valueOf(item.rows[item.rows.length - 1], aliases.dateProduction) ?? '').slice(0, 10);
                    const currentMinute = productionDate === todayString()
                        ? now.getHours() * 60 + now.getMinutes()
                        : 24 * 60;
                    const availableRows = item.rows.filter((row) => {
                        const minute = productionMinuteOf(row);
                        return minute != null && minute <= currentMinute;
                    });
                    const actual = availableRows
                        .filter((row) => String(valueOf(row, aliases.dateProduction) ?? '').slice(0, 10) === productionDate)
                        .reduce((sum, row) => sum + (numberOf(valueOf(row, aliases.actual)) ?? 0), 0);
                    const targetCheckpoint = checkpoints.find(label => {
                        const [hour, minute] = label.split(':').map(Number);
                        return hour * 60 + minute > currentMinute;
                    }) ?? checkpoints[checkpoints.length - 1];
                    const [targetHour, targetMinute] = targetCheckpoint.split(':').map(Number);
                    const targetCheckpointMinute = targetHour * 60 + targetMinute;
                    const targetRow = item.rows.find(row =>
                        String(valueOf(row, aliases.dateProduction) ?? '').slice(0, 10) === productionDate
                        && productionMinuteOf(row) === targetCheckpointMinute
                        && numberOf(valueOf(row, aliases.target)) != null);
                    const target = targetRow ? numberOf(valueOf(targetRow, aliases.target)) : null;
                    const latestRow = item.rows[item.rows.length - 1];
                    const points = checkpoints.map((label) => {
                        const [hour, minute] = label.split(':').map(Number);
                        const endMinute = hour * 60 + minute;
                        const checkpointRows = item.rows.filter((row) => {
                            const rowMinute = productionMinuteOf(row);
                            return String(valueOf(row, aliases.dateProduction) ?? '').slice(0, 10) === productionDate
                                && rowMinute != null
                                && rowMinute <= endMinute;
                        });
                        const checkpointTargetRow = [...item.rows].reverse().find((row) =>
                            productionMinuteOf(row) === endMinute
                            && numberOf(valueOf(row, aliases.target)) != null);
                        return {
                            time: label,
                            actual: checkpointRows.length
                                ? checkpointRows.reduce((sum, row) => sum + (numberOf(valueOf(row, aliases.actual)) ?? 0), 0)
                                : null,
                            target: checkpointTargetRow
                                ? numberOf(valueOf(checkpointTargetRow, aliases.target))
                                : null
                        };
                    });
                    if (productionDate === todayString() && nextCheckpoint() > currentCheckpoint()) {
                        points[nextCheckpoint()].actual = actual;
                    }
                    return {
                        row: latestRow,
                        rows: item.rows,
                        group: item.group,
                        code: item.code,
                        name: item.name,
                        snapshotDate: productionDate,
                        actual,
                        target,
                        targetMinute: targetRow ? productionMinuteOf(targetRow) : null,
                        points,
                        title: item.group || item.name || item.code || '挿入工程 / Nhóm Cắm',
                        status: statusOf(actual, target)
                    };
                })
                    .sort((a, b) => a.title.localeCompare(b.title, 'vi') || a.name.localeCompare(b.name, 'vi'));
            };
            const render = () => {
                const grouped = new Map();
                const productionRecords = records();
                const dailyTarget = productionRecords.reduce((sum, item) => {
                    const lastTargetRow = [...item.rows].reverse().find(row =>
                        numberOf(valueOf(row, aliases.target)) != null);
                    return sum + (lastTargetRow ? numberOf(valueOf(lastTargetRow, aliases.target)) : 0);
                }, 0);
                productionRecords.forEach((item) => {
                    const key = item.name || item.group || item.title;
                    const entry = grouped.get(key) || { title: key, target: 0, actual: 0 };
                    entry.target += item.target ?? 0;
                    entry.actual += item.actual ?? 0;
                    grouped.set(key, entry);
                });
                const items = [...grouped.values()].sort((a, b) => a.title.localeCompare(b.title, 'vi', { numeric: true }));
                const totalTarget = items.reduce((sum, item) => sum + item.target, 0);
                const totalActual = items.reduce((sum, item) => sum + item.actual, 0);
                $('#dailyTarget').textContent = productionRecords.length ? formatNumber(dailyTarget) : '—';
                $('#dailyActual').textContent = productionRecords.length ? formatNumber(totalActual) : '—';
                $('#dailyRate').textContent = dailyTarget > 0
                    ? `${formatNumber(totalActual / dailyTarget * 100, 1)}%` : '—';
                const rate = totalTarget > 0 ? totalActual / totalTarget * 100 : 0;
                $('#kpiTarget').textContent = formatNumber(totalTarget);
                const targetTimes = [...new Set(productionRecords.map(item => item.targetMinute)
                    .filter(minute => minute != null))].sort((a, b) => a - b)
                    .map(minute => `${String(Math.floor(minute / 60)).padStart(2, '0')}:${String(minute % 60).padStart(2, '0')}`);
                $('#targetTimeFrame').textContent = `目標時刻: ${targetTimes.length ? targetTimes.join(' / ') : '—'} / Khung giờ: ${targetTimes.length ? `${targetTimes.join(' / ')} giờ` : '—'}`;
                $('#kpiActual').textContent = formatNumber(totalActual);
                $('#kpiRate').textContent = `${formatNumber(rate, 1)}%`;
                $('#kpiMissing').textContent = formatNumber(Math.max(0, totalTarget - totalActual));
                $('#totalProgress').style.width = `${Math.min(100, rate)}%`;
                $('.overview-progress').setAttribute('aria-valuenow', String(Math.min(100, rate)));
                $('.overview-progress').setAttribute('aria-valuetext', `${formatNumber(rate, 1)}%`);
                const now = new Date();
                $('#summaryMonth').textContent = `${now.getMonth() + 1}/${now.getFullYear()}`;
                $('.summary-table tbody').innerHTML = state.qualityRows.length
                    ? state.qualityRows.map(row => {
                        const target = numberOf(row.targetError ?? row.TargetError);
                        const actual = numberOf(row.inputError ?? row.InputError);
                        const status = target == null || actual == null
                            ? 'データなし / Chưa có dữ liệu'
                            : actual <= target ? 'Đạt' : 'Không đạt';
                        const group = row.lastNameSub ?? row.LastNameSub ?? '—';
                        return `<tr><td>${escapeHtml(group)}</td><td class="summary-target">${formatNumber(target, 2)}</td><td class="summary-actual">${formatNumber(actual, 2)}</td><td><span class="summary-status">${status}</span></td></tr>`;
                    }).join('')
                    : '<tr><td>—</td><td class="summary-target">—</td><td class="summary-actual">—</td><td><span class="summary-status">データなし / Chưa có dữ liệu</span></td></tr>';
                const qualityTargets = state.qualityRows.map(row => numberOf(row.targetError ?? row.TargetError));
                const qualityActuals = state.qualityRows.map(row => numberOf(row.inputError ?? row.InputError));
                const totalQualityTarget = qualityTargets.some(value => value != null)
                    ? qualityTargets.reduce((sum, value) => sum + (value ?? 0), 0) : null;
                const totalQualityActual = qualityActuals.some(value => value != null)
                    ? qualityActuals.reduce((sum, value) => sum + (value ?? 0), 0) : null;
                const qualityStatus = qualityTargets.length === 0
                    || qualityTargets.some(value => value == null) || qualityActuals.some(value => value == null)
                    ? 'データなし / Chưa có dữ liệu'
                    : totalQualityActual <= totalQualityTarget ? 'Đạt' : 'Không đạt';
                $('.summary-table tfoot').innerHTML = `<tr><td><strong>Tổng</strong></td><td><strong>${formatNumber(totalQualityTarget, 2)}</strong></td><td><strong>${formatNumber(totalQualityActual, 2)}</strong></td><td><span class="summary-status">${qualityStatus}</span></td></tr>`;
                if (!items.length) {
                    $('#machineGrid').innerHTML = '<div class="empty-state">挿入工程の生産データがありません / Không có dữ liệu sản xuất công đoạn Cắm.</div>';
                    return;
                }
                const width = Math.max(850, items.length * 205 + 110);
                const height = 465, left = 85, top = 36, bottom = 370;
                const peak = Math.max(1, ...items.flatMap(item => [item.target, item.actual]));
                const roughStep = peak / 5;
                const magnitude = 10 ** Math.floor(Math.log10(roughStep));
                const step = [1, 2, 2.5, 5, 10].map(n => n * magnitude).find(n => n >= roughStep);
                const maximum = Math.ceil(peak / step) * step;
                const plotWidth = width - left - 20;
                const slot = plotWidth / items.length;
                const barWidth = Math.min(105, slot * .36);
                const y = value => bottom - value / maximum * (bottom - top);
                let drawing = '';
                for (let value = 0; value <= maximum; value += step) {
                    const pos = y(value);
                    drawing += `<line x1="${left}" y1="${pos}" x2="${width - 20}" y2="${pos}" class="grid-line"/><text x="${left - 15}" y="${pos + 6}" text-anchor="end" class="axis-label">${formatNumber(value)}</text>`;
                }
                drawing += `<path d="M${left} ${top}V${bottom}H${width - 20}" class="axis-line"/>`;
                items.forEach((item, index) => {
                    const center = left + slot * (index + .5);
                    const percent = item.target > 0 ? `${formatNumber(item.actual / item.target * 100, 1)}%` : '—';
                    [[item.target, center - barWidth, 'targetBar'], [item.actual, center, 'actualBar']].forEach(([value, x, fill]) => {
                        drawing += `<rect x="${x}" y="${y(value)}" width="${barWidth}" height="${bottom - y(value)}" rx="6" fill="url(#${fill})"><title>${escapeHtml(item.title)} · ${fill === 'targetBar' ? '目標 / Mục tiêu' : '実績 / Thực tế'}: ${formatNumber(value)}</title></rect><text x="${x + barWidth / 2}" y="${y(value) - 10}" text-anchor="middle" class="bar-label">${formatNumber(value)}</text>`;
                    });
                    drawing += `<text x="${center}" y="${bottom + 28}" text-anchor="middle" class="group-label">${escapeHtml(item.title)}</text><rect x="${center - 52}" y="${bottom + 42}" width="104" height="30" rx="15" class="rate-pill"/><text x="${center}" y="${bottom + 63}" text-anchor="middle" class="rate-label">${percent}</text>`;
                });
                $('#machineGrid').innerHTML = `<svg class="production-chart" viewBox="0 0 ${width} ${height}" role="img" aria-labelledby="plotTitle plotDescription"><title id="plotTitle">挿入工程のグループ別生産量 / Sản lượng các nhóm Cắm</title><desc id="plotDescription">${escapeHtml(items.map(item => `${item.title}: 目標 / Mục tiêu ${formatNumber(item.target)}, 実績 / Thực tế ${formatNumber(item.actual)}`).join('; '))}</desc><defs><linearGradient id="targetBar" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ffa600"/><stop offset="1" stop-color="#ff9400"/></linearGradient><linearGradient id="actualBar" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#00c8ed"/><stop offset="1" stop-color="#00b6e4"/></linearGradient></defs>${drawing}</svg>`;
            };
            const loadData = async () => {
                $('#liveText').textContent = '更新中 / Đang cập nhật';
                $('#refreshButton').disabled = true;
                $('.live').dataset.status = 'loading';
                try {
                    const response = await fetch('/api/plug-production/data', { headers: { Accept: 'application/json' } });
                    if (!response.ok) throw new Error(`データ取得エラー / Lỗi tải dữ liệu (${response.status})`);
                    const data = await response.json();
                    state.rows = data.rows ?? data.Rows ?? [];
                    state.columns = data.columns ?? data.Columns ?? [];
                    state.totalRows = data.totalRows ?? data.TotalRows ?? state.rows.length;
                    state.truncated = data.isTruncated ?? data.IsTruncated ?? false;
                    state.qualityRows = data.qualityRows ?? data.QualityRows ?? [];
                    render();
                    $('.live').dataset.status = 'connected';
                    $('#dataNote').textContent = state.truncated
                        ? `最大 ${formatNumber(state.rows.length)} / ${formatNumber(state.totalRows)} 行を表示 · 当日の生産 / Đang hiển thị tối đa ${formatNumber(state.rows.length)} / ${formatNumber(state.totalRows)} dòng · Ngày sản xuất hiện tại`
                        : 'データソース / Nguồn dữ liệu: Control_ProgramPlug_Visualize · 当日の生産 / Ngày sản xuất hiện tại';
                    $('#lastUpdated').textContent = `更新時刻 / Cập nhật lúc ${new Date().toLocaleTimeString('vi-VN', { hour12: false })}`;
                    $('#liveText').textContent = 'リアルタイム稼働中 / Đang trực tiếp';
                } catch (error) {
                    $('.live').dataset.status = 'error';
                    $('#machineGrid').innerHTML = `<div class="error-state">${escapeHtml(error.message || '生産データを取得できません / Không thể tải dữ liệu sản xuất.')}</div>`;
                    $('#liveText').textContent = '接続が切断されました / Mất kết nối';
                } finally {
                    $('#refreshButton').disabled = false;
                }
            };
            const applyTheme = (theme) => {
                document.documentElement.setAttribute('data-theme', theme);
                const dark = theme === 'dark';
                $('#themeButton').textContent = '☀☾';
                $('#themeButton').setAttribute('aria-pressed', String(dark));
                $('#themeButton').setAttribute('aria-label', dark
                    ? 'ライトモードに切り替え / Chuyển sang giao diện sáng'
                    : 'ダークモードに切り替え / Chuyển sang giao diện tối');
                try { localStorage.setItem('stamping-wire-theme-v2', theme); } catch { }
            };
            applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
            const updateClock = () => {
                const now = new Date();
                $('#clock').textContent = now.toLocaleTimeString('vi-VN', { hour12: false });
                $('#dailyTargetDate').textContent = now.toLocaleDateString('vi-VN', {
                    day: '2-digit', month: '2-digit', year: 'numeric'
                });
            };
            $('#themeButton').addEventListener('click', () => applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'));
            $('#refreshButton').addEventListener('click', loadData);
            $('#fullscreenButton').addEventListener('click', async () => {
                if (!document.fullscreenElement) await document.documentElement.requestFullscreen();
                else await document.exitFullscreen();
            });
            window.addEventListener('resize', render);
            updateClock();
            window.setInterval(updateClock, 1000);
            window.setInterval(loadData, 60000);
            loadData();
        })();
    </script>
</body>
</html>
